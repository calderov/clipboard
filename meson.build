project(
    'io.github.calderov.ClipboardHistory',
    'vala', 'c',
    version: '0.1.0',
    meson_version: '>= 0.62.0',
)

gnome = import('gnome')
app_id = meson.project_name()

# The C generated by valac is noisy; Vala reports the warnings that matter.
add_project_arguments('-w', language: 'c')

subdir('data')
subdir('src')
